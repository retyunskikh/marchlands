    \u043F\u0435\u0445\u043E\u0442\u0443 \u2014 \u0444\u0443\u0437\u0438\u043B\u0451\u0440\u043E\u0432
    \u0438 \u0433\u0440\u0435\u043D\u0430\u0434\u0451\u0440\u043E\u0432. \u0421\u0442\u0430\u0432\u0438\u0442\u0441\u044F
    \u0440\u044F\u0434\u043E\u043C \u0441\u043E \u0448\u0442\u0430\u0431\u043E\u043C.
    \u041A\u043B\u0430\u0432\u0438\u0448\u0430 B \u2014 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C
    \u043A\u0430\u0437\u0430\u0440\u043C\u0443."
