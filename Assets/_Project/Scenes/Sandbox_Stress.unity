--- !u!114 &680005307
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 680005305}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: add159466789c984593ee7acfa57c43f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Game.UI::Marchlands.UI.UnitInfoPanel
  panel: {fileID: 1864823349}
  titleLabel: {fileID: 2132988776}
  bodyLabel: {fileID: 813460324}
  closeButton: {fileID: 397019234}
  portrait: {fileID: 613399376}
  francePortraits:
  - {fileID: 21300000, guid: bc46f8b0b32bd0a4c922510a174ca3bf, type: 3}
  - {fileID: 21300000, guid: aad90d5e78f15c74cb194d9ff4a3b94d, type: 3}
  - {fileID: 21300000, guid: 0de4c7d01ca76c444840fc06a8375673, type: 3}
  - {fileID: 21300000, guid: 0de4c7d01ca76c444840fc06a8375673, type: 3}
  - {fileID: 21300000, guid: 3b322d57f5da43343b4949e375a50149, type: 3}
  austriaPortraits:
  - {fileID: 21300000, guid: ab2f18521932d864d9bfdab4552465b6, type: 3}
  - {fileID: 21300000, guid: 70f806e428a34f54d927fbb337a98533, type: 3}
  - {fileID: 21300000, guid: e52bac5a38a67d641815559cc7121cb9, type: 3}
  - {fileID: 21300000, guid: e52bac5a38a67d641815559cc7121cb9, type: 3}
  - {fileID: 21300000, guid: fd16e7f81ab256846b82832871397e36, type: 3}
  grenadiersTitle: "\u0413\u0440\u0435\u043D\u0430\u0434\u0451\u0440\u044B"
  fusiliersTitle: "\u0424\u0443\u0437\u0438\u043B\u0451\u0440\u044B"
  cavalryTitle: "\u041A\u043E\u043D\u043D\u0438\u0446\u0430"
  grenadiersNote: "\u041E\u0442\u0431\u043E\u0440\u043D\u0430\u044F \u043F\u0435\u0445\u043E\u0442\u0430:
    \u043C\u0435\u0442\u0447\u0435 \u0441\u0442\u0440\u0435\u043B\u044F\u044E\u0442,
    \u043A\u0440\u0435\u043F\u043A\u0430\u044F \u043C\u043E\u0440\u0430\u043B\u044C,
    \u0441\u0438\u043B\u044C\u043D\u044B \u0432 \u0448\u0442\u044B\u043A\u043E\u0432\u043E\u0439.
    \u0414\u043E\u0440\u043E\u0436\u0435 \u0444\u0443\u0437\u0438\u043B\u0451\u0440\u043E\u0432
    \u0438 \u043D\u0430\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F \u0432\u0434\u0432\u043E\u0435
    \u0434\u043E\u043B\u044C\u0448\u0435."
  fusiliersNote: "\u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u043B\u0438\u043D\u0435\u0439\u043D\u0430\u044F
    \u043F\u0435\u0445\u043E\u0442\u0430: \u0434\u0451\u0448\u0435\u0432\u044B \u0438
    \u0431\u044B\u0441\u0442\u0440\u043E \u043D\u0430\u0431\u0438\u0440\u0430\u044E\u0442\u0441\u044F,
    \u043D\u043E \u0443\u0441\u0442\u0443\u043F\u0430\u044E\u0442 \u0433\u0440\u0435\u043D\u0430\u0434\u0451\u0440\u0430\u043C
    \u0432 \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u0438 \u0438 \u0448\u0442\u044B\u043A\u043E\u0432\u043E\u0439."
  cavalryNote: "\u0414\u043E\u0440\u043E\u0433\u0430\u044F \u0438 \u0431\u044B\u0441\u0442\u0440\u0430\u044F,
    \u0441\u0442\u0440\u0430\u0448\u043D\u0430 \u0432 \u0430\u0442\u0430\u043A\u0435
    \u0432 \u0441\u0430\u0431\u043B\u0438. \u0421\u0442\u0440\u0435\u043B\u044F\u0442\u044C
    \u043D\u0435 \u043C\u043E\u0436\u0435\u0442."
  artilleryTitle: "\u041F\u0443\u0448\u043A\u0438"
  artilleryNote: "\u041F\u0443\u0448\u043A\u0430 \u0441 \u0440\u0430\u0441\u0447\u0451\u0442\u043E\u043C.
    \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u0430\u044F; \u0447\u0442\u043E\u0431\u044B
    \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C, \u0441\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
    \u0441 \u043F\u0435\u0440\u0435\u0434\u043A\u0430, \u0447\u0442\u043E\u0431\u044B
    \u0435\u0445\u0430\u0442\u044C \u2014 \u0431\u0435\u0440\u0451\u0442\u0441\u044F
    \u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u043E\u043A. \u042F\u0434\u0440\u043E\u043C
    \u0431\u044C\u0451\u0442 \u0434\u0430\u043B\u0435\u043A\u043E, \u043D\u0430\u0432\u0435\u0441\u043E\u043C
    \u0447\u0435\u0440\u0435\u0437 \u0441\u0432\u043E\u0438\u0445, \u0440\u0438\u043A\u043E\u0448\u0435\u0442\u043E\u043C
    \u0432\u044B\u043A\u0430\u0448\u0438\u0432\u0430\u0435\u0442 \u0440\u044F\u0434\u044B
    \u2014 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043A\u043E\u043B\u043E\u043D\u043D\u0443
    \u0438 \u0441\u0442\u0440\u043E\u0439 \u043D\u0430 \u043C\u043E\u0441\u0442\u0443.
    \u0412 \u0430\u0442\u0430\u043A\u0443 \u043D\u0435 \u0445\u043E\u0434\u0438\u0442."
  gunCostFormat: "\u0426\u0435\u043D\u0430: {0} \u0437\u043E\u043B\u043E\u0442\u0430
    \u0437\u0430 \u043F\u0443\u0448\u043A\u0443 \u0441 \u0440\u0430\u0441\u0447\u0451\u0442\u043E\u043C;
    \u043A\u0430\u0436\u0434\u0430\u044F \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
    \u0432 {1} \u0440\u0430\u0437\u0430 \u0434\u043E\u0440\u043E\u0436\u0435, \u043F\u043E\u043A\u0430
    \u043F\u0440\u0435\u0436\u043D\u0438\u0435 \u0432 \u0441\u0442\u0440\u043E\u044E"
  upgradeBarracksTitle: "\u0423\u0441\u0438\u043B\u0438\u0442\u044C \u043A\u0430\u0437\u0430\u0440\u043C\u0443"
  expandStableTitle: "\u0420\u0430\u0441\u0448\u0438\u0440\u0438\u0442\u044C \u043A\u043E\u043D\u044E\u0448\u043D\u044E"
  expandStableNote: "\u041A\u043E\u043D\u044E\u0448\u043D\u044E \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u044E\u0442:
    \u0432 \u043D\u0435\u0439 \u0432\u0441\u0442\u0430\u043D\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435
    \u043A\u043E\u043D\u0435\u0439 \u2014 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u043D\u044F\u0442\u044C
    \u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435
    \u043A\u043E\u043D\u043D\u0438\u0446\u044B. \u041F\u043E\u043A\u0430 \u0438\u0434\u0451\u0442
    \u0441\u0442\u0440\u043E\u0439\u043A\u0430, \u043D\u0430\u0439\u043C \u0441\u0442\u043E\u0438\u0442."
  horsesName: "\u041A\u043E\u043D\u0435\u0439 \u0432 \u044D\u0442\u043E\u0439 \u043A\u043E\u043D\u044E\u0448\u043D\u0435"
  upgradeHeadquartersTitle: "\u0423\u043A\u0440\u0435\u043F\u0438\u0442\u044C \u0448\u0442\u0430\u0431"
  upgradeBlockhouseTitle: "\u0423\u043A\u0440\u0435\u043F\u0438\u0442\u044C \u0431\u043B\u043E\u043A\u0433\u0430\u0443\u0437"
  upgradeBarracksNote: "\u0414\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u0443\u044E
    \u043A\u0430\u0437\u0430\u0440\u043C\u0443 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044E\u0442
    \u0432 \u043A\u0430\u043C\u0435\u043D\u043D\u0443\u044E. \u041F\u043E\u043A\u0430
    \u0438\u0434\u0451\u0442 \u0441\u0442\u0440\u043E\u0439\u043A\u0430, \u043D\u0430\u0439\u043C
    \u0441\u0442\u043E\u0438\u0442."
  upgradeHeadquartersNote: "\u0414\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439
    \u0448\u0442\u0430\u0431 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044E\u0442
    \u0432 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439: \u0431\u0430\u0437\u0443
    \u0434\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0432\u0437\u044F\u0442\u044C
    \u0448\u0442\u0443\u0440\u043C\u043E\u043C."
  upgradeBlockhouseNote: "\u0414\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439
    \u0431\u043B\u043E\u043A\u0433\u0430\u0443\u0437 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044E\u0442
    \u0432 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439: \u043A\u0440\u0435\u043F\u0447\u0435,
    \u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A\u043E\u0432,
    \u0431\u044C\u044E\u0442 \u0434\u0430\u043B\u044C\u0448\u0435."
  upgradeChangeFormat: "{0}: {1} \u2192 {2}"
  upgradeHealthName: "\u041F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C"
  upgradeSentriesName: "\u0420\u0443\u0436\u0435\u0439 \u0443 \u0447\u0430\u0441\u043E\u0432\u044B\u0445"
  upgradeDefendersName: "\u0421\u0442\u0440\u0435\u043B\u043A\u043E\u0432"
  upgradeRangeName: "\u0414\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u043E\u0433\u043D\u044F"
  upgradeHireFormat: "\u041D\u0430\u0439\u043C: \u0432 {0} \u0440\u0430\u0437\u0430
    \u0431\u044B\u0441\u0442\u0440\u0435\u0435"
  upgradeCostFormat: "\u0426\u0435\u043D\u0430: {0} \u0437\u043E\u043B\u043E\u0442\u0430,
    \u0441\u0442\u0440\u043E\u044F\u0442 {1} \u0441"
  balloonTitle: "\u0412\u043E\u0437\u0434\u0443\u0448\u043D\u044B\u0439 \u0448\u0430\u0440"
  balloonNote: "\u041F\u0440\u0438\u0432\u044F\u0437\u043D\u043E\u0439 \u0448\u0430\u0440
    \u043D\u0430\u0434 \u0448\u0442\u0430\u0431\u043E\u043C: \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u0435\u043B\u044C
    \u0432\u0438\u0434\u0438\u0442 \u0432\u0441\u0451 \u043F\u043E\u043B\u0435. \u0422\u0443\u043C\u0430\u043D
    \u0432\u043E\u0439\u043D\u044B \u0434\u043B\u044F \u0432\u0430\u0441 \u0441\u043D\u044F\u0442
    \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0431\u043E\u044F \u2014 \u0432\u0438\u0434\u043D\u044B
    \u0432\u0441\u0435 \u043E\u0442\u0440\u044F\u0434\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430."
  balloonCostFormat: "\u0426\u0435\u043D\u0430: {0} \u0437\u043E\u043B\u043E\u0442\u0430,
    \u0438\u0437\u0443\u0447\u0430\u044E\u0442 {1} \u0441"
