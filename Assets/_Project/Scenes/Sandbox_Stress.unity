  text: "<b>\u041A\u043E\u043D\u043D\u0438\u0446\u0430</b>\n\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C
    \u0438\u043B\u0438 \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043D\u0430\u0439\u043C.
