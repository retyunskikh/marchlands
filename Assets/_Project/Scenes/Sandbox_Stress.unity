  text: "<b>\u041A\u043E\u043D\u0438</b>\n\u0421\u043A\u043E\u043B\u044C\u043A\u043E
    \u043A\u043E\u043D\u0435\u0439 \u0437\u0430\u043D\u044F\u0442\u043E \u0438 \u0441\u043A\u043E\u043B\u044C\u043A\u043E
