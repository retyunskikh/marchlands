  text: "<b>\u0413\u0440\u0435\u043D\u0430\u0434\u0451\u0440\u044B</b>\n\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C
    \u0438\u043B\u0438 \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043D\u0430\u0439\u043C.
