  m_Script: {fileID: 11500000, guid: f4c0c58e98c4d1749b9ed423f786806b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Game.UI::Marchlands.UI.BuildPanel
  placementButtons: {fileID: 939718271}
  confirmButton: {fileID: 1743920312}
  cancelButton: {fileID: 157826811}
  hintLabel: {fileID: 1126094070}
  chooseSiteText: "\u0422\u0430\u043F\u043D\u0438\u0442\u0435, \u0433\u0434\u0435
    \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0437\u0434\u0430\u043D\u0438\u0435"
  validSiteText: "\u041C\u0435\u0441\u0442\u043E \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442"
  farFromHeadquartersText: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u0430\u043B\u0435\u043A\u043E
    \u043E\u0442 \u0448\u0442\u0430\u0431\u0430 \u2014 \u0431\u043B\u0438\u0436\u0435
    \u043A \u043D\u0435\u043C\u0443"
  tooCloseToBuildingText: "\u0412\u043F\u043B\u043E\u0442\u043D\u0443\u044E \u043A
    \u0434\u0440\u0443\u0433\u043E\u043C\u0443 \u0437\u0434\u0430\u043D\u0438\u044E
    \u2014 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u0435 \u043E\u0442 \u043D\u0435\u0433\u043E"
  tooCloseToVillageText: "\u0412\u043F\u043B\u043E\u0442\u043D\u0443\u044E \u043A
    \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u2014 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u0435
    \u043E\u0442 \u043D\u0435\u0451"
  noGoldText: "\u041D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0437\u043E\u043B\u043E\u0442\u0430"
  atLimitText: "\u0422\u0430\u043A\u043E\u0435 \u0437\u0434\u0430\u043D\u0438\u0435
    \u0443\u0436\u0435 \u0435\u0441\u0442\u044C"
