  m_Name: 
  m_EditorClassIdentifier: Game.UI::Marchlands.UI.GameMenu
  pauseButton: {fileID: 1578335351}
  pauseOverlay: {fileID: 432363802}
  resumeButton: {fileID: 636697752}
  pauseRestartButton: {fileID: 569079081}
  pauseMenuButton: {fileID: 744081620}
  pauseQuitButton: {fileID: 1213762192}
  musicVolumeSlider: {fileID: 1342623671}
  musicVolumeLabel: {fileID: 2075636753}
  musicVolumeFormat: "\u0413\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C \u043C\u0443\u0437\u044B\u043A\u0438:
    {0}%"
  resultOverlay: {fileID: 859859332}
  resultTitle: {fileID: 153383298}
  resultReason: {fileID: 1090686898}
  resultRestartButton: {fileID: 1682336004}
  resultMenuButton: {fileID: 343408033}
  fireworks: {fileID: 69363321}
  victoryText: "\u041F\u043E\u0431\u0435\u0434\u0430!"
  defeatText: "\u041F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435"
  headquartersReason: "\u0420\u0430\u0437\u0440\u0443\u0448\u0435\u043D \u0448\u0442\u0430\u0431"
  dominationReason: "\u0423\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u0434\u0435\u0440\u0435\u0432\u0435\u043D\u044C"
  annihilationReason: "\u0410\u0440\u043C\u0438\u044F \u0440\u0430\u0437\u0431\u0438\u0442\u0430"
  menuSceneName: MainMenu
  opponentLeftReason: "\u0421\u043E\u043F\u0435\u0440\u043D\u0438\u043A \u043F\u043E\u043A\u0438\u043D\u0443\u043B
    \u0431\u043E\u0439"
  connectionLostTitle: "\u0411\u043E\u0439 \u043F\u0440\u0435\u0440\u0432\u0430\u043D"
  connectionLostReason: "\u0421\u0432\u044F\u0437\u044C \u0441 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u043E\u043C
    \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u0430"
  desyncReason: "\u0418\u0433\u0440\u044B \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C
    (\u0440\u0430\u0441\u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u044F)
    \u2014 \u0431\u043E\u0439 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D"
  waitingText: "\u041E\u0436\u0438\u0434\u0430\u043D\u0438\u0435 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0430\u2026"
  waitingColor: {r: 0.96, g: 0.9, b: 0.75, a: 1}
  networkInfoFormat: "\u041F\u0438\u043D\u0433 {0} \u043C\u0441 \xB7 \u043F\u0440\u0438\u043A\u0430\u0437
    \u0447\u0435\u0440\u0435\u0437 {1:0.0} \u0441"
  networkInfoColor: {r: 0.96, g: 0.9, b: 0.75, a: 0.7}
  hotkeysText: "<b>\u041A\u043B\u0430\u0432\u0438\u0448\u0438 \u0438 \u043C\u044B\u0448\u044C</b>\n\n\u041B\u041A\u041C
    \u2014 \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u043E\u0442\u0440\u044F\u0434
    \u0438\u043B\u0438 \u0437\u0434\u0430\u043D\u0438\u0435; Shift + \u0440\u0430\u043C\u043A\u0430
    \u2014 \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E;
    Ctrl + \u0449\u0435\u043B\u0447\u043E\u043A \u2014 \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C
    \u0438\u043B\u0438 \u0443\u0431\u0440\u0430\u0442\u044C\n\u0414\u0432\u043E\u0439\u043D\u043E\u0439
    \u0449\u0435\u043B\u0447\u043E\u043A \u043F\u043E \u043E\u0442\u0440\u044F\u0434\u0443
    \u2014 \u0432\u0441\u0435 \u0442\u0430\u043A\u0438\u0435 \u0436\u0435 \u043D\u0430
    \u044D\u043A\u0440\u0430\u043D\u0435\n\u041F\u041A\u041C \u2014 \u0438\u0434\u0442\u0438
    \u0438\u043B\u0438 \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C; \u041F\u041A\u041C
    \u0441 \u043F\u0440\u043E\u0442\u044F\u0436\u043A\u043E\u0439 \u2014 \u0432\u0441\u0442\u0430\u0442\u044C
    \u0444\u0440\u043E\u043D\u0442\u043E\u043C \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
    \u043F\u0440\u043E\u0442\u044F\u0436\u043A\u0438\n\u041F\u043E\u0442\u044F\u043D\u0443\u0442\u044C
    \u041B\u041A\u041C \u0437\u0430 \u043A\u043E\u043B\u044C\u0446\u043E \u0432\u043E\u043A\u0440\u0443\u0433
    \u043E\u0442\u0440\u044F\u0434\u0430 \u2014 \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u0442\u044C
    \u043D\u0430 \u043C\u0435\u0441\u0442\u0435\n\n\u041F\u0440\u043E\u0431\u0435\u043B
    \u2014 \u0437\u0430\u043B\u043F   \xB7   C \u2014 \u0432 \u0448\u0442\u044B\u043A\u0438  
    \xB7   R \u2014 \u043B\u0438\u043D\u0438\u044F / \u043C\u0430\u0440\u0448   \xB7  
    X \u2014 \u0441\u0442\u043E\u043F\nH \u2014 \u0448\u0442\u0430\u0431   \xB7  
    B \u2014 \u043A\u0430\u0437\u0430\u0440\u043C\u0430   \xB7   Tab \u2014 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
    \u043E\u0442\u0440\u044F\u0434\nCtrl + 1\u20269 \u2014 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C
    \u0433\u0440\u0443\u043F\u043F\u0443; 1\u20269 \u2014 \u0432\u044B\u0431\u0440\u0430\u0442\u044C
    \u0435\u0451; \u0434\u0432\u0430\u0436\u0434\u044B \u2014 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C\nWASD
    \u0438\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u043A\u0438, \u043A\u0440\u0430\u0439
    \u044D\u043A\u0440\u0430\u043D\u0430, \u0441\u0440\u0435\u0434\u043D\u044F\u044F
    \u043A\u043D\u043E\u043F\u043A\u0430 \u2014 \u0434\u0432\u0438\u0433\u0430\u0442\u044C
    \u043A\u0430\u0440\u0442\u0443; \u043A\u043E\u043B\u0435\u0441\u043E \u2014 \u043C\u0430\u0441\u0448\u0442\u0430\u0431\n\nPause
    \u0438\u043B\u0438 P \u2014 \u043F\u0430\u0443\u0437\u0430   \xB7   Esc \u2014
    \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C   \xB7   F1 \u2014 \u044D\u0442\u0430
    \u0441\u043F\u0440\u0430\u0432\u043A\u0430\n\u041D\u0430\u0432\u0435\u0434\u0438\u0442\u0435
    \u043A\u0443\u0440\u0441\u043E\u0440 \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443
    \u2014 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430."
  helpBackground: {r: 0.12, g: 0.1, b: 0.08, a: 0.92}
