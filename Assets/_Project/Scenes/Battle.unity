--- !u!114 &1628235495
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1628235492}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f02fa605c5a60ee4281f04cb6b5fd19e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Game.Bootstrap::Marchlands.Bootstrap.TutorialDirector
  panel: {fileID: 1946981313}
  messages:
  - "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C!
    \u0412\u044B \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0435\u0442\u0435 \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0430\u043C\u0438
    (\u0441\u0438\u043D\u0438\u0435). \u041D\u0430\u0436\u043C\u0438\u0442\u0435
    \xAB\u0414\u0430\u043B\u0435\u0435\xBB."
  - "\u0421\u0434\u0432\u0438\u043D\u044C\u0442\u0435 \u043A\u0430\u0440\u0442\u0443
    \u043F\u0430\u043B\u044C\u0446\u0435\u043C. \u0414\u0432\u0443\u043C\u044F \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438
    \u2014 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u044C\u0442\u0435 \u0438\u043B\u0438
    \u043E\u0442\u0434\u0430\u043B\u0438\u0442\u0435."
  - "\u0422\u0430\u043F\u043D\u0438\u0442\u0435 \u043F\u043E \u0441\u0432\u043E\u0435\u043C\u0443
    \u043E\u0442\u0440\u044F\u0434\u0443 \u2014 \u043E\u043D \u043E\u0431\u0432\u0435\u0434\u0451\u043D
    \u043A\u0440\u0443\u0433\u043E\u043C."
  - "\u041F\u0440\u043E\u0432\u0435\u0434\u0438\u0442\u0435 \u043F\u0430\u043B\u044C\u0446\u0435\u043C
    \u043E\u0442 \u043E\u0442\u0440\u044F\u0434\u0430 \u0432 \u043B\u044E\u0431\u0443\u044E
    \u0442\u043E\u0447\u043A\u0443 \u043F\u043E\u043B\u044F \u2014 \u043E\u0442\u0440\u044F\u0434
    \u043F\u043E\u0439\u0434\u0451\u0442 \u0442\u0443\u0434\u0430."
  - "\u041F\u043E\u0442\u044F\u043D\u0438\u0442\u0435 \u0437\u0430 \u043A\u043E\u043B\u044C\u0446\u043E
    \u0432\u043E\u043A\u0440\u0443\u0433 \u043E\u0442\u0440\u044F\u0434\u0430 \u2014
    \u043E\u043D \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F.
    \u041B\u0438\u043D\u0438\u044F \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442
    \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043F\u0435\u0440\u0451\u0434, \u0432
    \u0436\u0451\u043B\u0442\u044B\u0439 \u0441\u0435\u043A\u0442\u043E\u0440."
  - "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041C\u0430\u0440\u0448\xBB
    \u2014 \u043E\u0442\u0440\u044F\u0434 \u0432\u0441\u0442\u0430\u043D\u0435\u0442
    \u0432 \u043A\u043E\u043B\u043E\u043D\u043D\u0443 (\u0431\u044B\u0441\u0442\u0440\u0435\u0435
    \u0438\u0434\u0451\u0442, \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442).
    \xAB\u0412 \u043B\u0438\u043D\u0438\u044E\xBB \u2014 \u043E\u0431\u0440\u0430\u0442\u043D\u043E."
  - "\u041E\u0442\u043F\u0440\u0430\u0432\u044C\u0442\u0435 \u043E\u0442\u0440\u044F\u0434
    \u0432 \u043E\u0431\u0432\u0435\u0434\u0451\u043D\u043D\u0443\u044E \u0434\u0435\u0440\u0435\u0432\u043D\u044E
    \u0438 \u0441\u0442\u043E\u0439\u0442\u0435 \u0442\u0430\u043C, \u043F\u043E\u043A\u0430
    \u0444\u043B\u0430\u0433 \u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0442 \u0441\u0438\u043D\u0438\u043C.
    \u0414\u0435\u0440\u0435\u0432\u043D\u0438 \u0434\u0430\u044E\u0442 \u0437\u043E\u043B\u043E\u0442\u043E."
  - "\u0412\u0440\u0430\u0433 \u0438\u0434\u0451\u0442 \u043D\u0430 \u0432\u0430\u0441
    (\u043E\u0431\u0432\u0435\u0434\u0451\u043D)! \u0420\u0430\u0437\u0432\u0435\u0440\u043D\u0438\u0442\u0435
    \u043A \u043D\u0435\u043C\u0443 \u043B\u0438\u043D\u0438\u044E. \u041A\u043E\u0433\u0434\u0430
    \u043E\u043D \u0432\u043E\u0439\u0434\u0451\u0442 \u0432 \u0436\u0451\u043B\u0442\u044B\u0439
    \u0441\u0435\u043A\u0442\u043E\u0440 \u2014 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \xAB\u0417\u0430\u043B\u043F!\xBB."
  - "\u041E\u0442\u0440\u044F\u0434 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0436\u0430\u0435\u0442\u0441\u044F
    \u2014 \u043A\u043E\u043B\u044C\u0446\u043E \u0437\u0430 \u043D\u0438\u043C \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442\u0441\u044F.
    \u041F\u043E\u043B\u043E\u0441\u043A\u0430 \u043D\u0430\u0434 \u043E\u0442\u0440\u044F\u0434\u043E\u043C
    \u2014 \u0431\u043E\u0435\u0432\u043E\u0439 \u0434\u0443\u0445: \u043F\u0440\u0438
    \u043F\u043E\u0442\u0435\u0440\u044F\u0445 \u043E\u043D \u043F\u0430\u0434\u0430\u0435\u0442,
    \u0438 \u043E\u0442\u0440\u044F\u0434 \u0431\u0435\u0436\u0438\u0442. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
    \xAB\u0414\u0430\u043B\u0435\u0435\xBB."
  - "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0412 \u0448\u0442\u044B\u043A\u0438\xBB
    \u0438 \u0442\u0430\u043F\u043D\u0438\u0442\u0435 \u043F\u043E \u043E\u0431\u0432\u0435\u0434\u0451\u043D\u043D\u043E\u043C\u0443
    \u0432\u0440\u0430\u0433\u0443. \u0423\u0434\u0430\u0440 \u0432\u043E \u0444\u043B\u0430\u043D\u0433
    \u0438\u043B\u0438 \u0432 \u0442\u044B\u043B \u0441\u0438\u043B\u044C\u043D\u0435\u0435."
  - "\u0422\u0430\u043F\u043D\u0438\u0442\u0435 \u043F\u043E \u0441\u0432\u043E\u0435\u043C\u0443
    \u0448\u0442\u0430\u0431\u0443 (\u043E\u0431\u0432\u0435\u0434\u0451\u043D),
    \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041A\u0430\u0437\u0430\u0440\u043C\u0430\xBB,
    \u0442\u0430\u043F\u043D\u0438\u0442\u0435 \u043C\u0435\u0441\u0442\u043E \u0440\u044F\u0434\u043E\u043C
    \u0441\u043E \u0448\u0442\u0430\u0431\u043E\u043C \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \xAB\u041F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C\xBB."
  - "\u0422\u0430\u043F\u043D\u0438\u0442\u0435 \u043F\u043E \u043A\u0430\u0437\u0430\u0440\u043C\u0435
    (\u043E\u0431\u0432\u0435\u0434\u0435\u043D\u0430), \u043A\u043E\u0433\u0434\u0430
    \u043E\u043D\u0430 \u0434\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u0441\u044F,
    \u0438 \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u043D\u0430\u0439\u043C
    \u0444\u0443\u0437\u0438\u043B\u0451\u0440\u043E\u0432."
  - "\u0420\u0435\u043A\u0440\u0443\u0442\u044B \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0442\u0441\u044F
    \u0443 \u043A\u0430\u0437\u0430\u0440\u043C\u044B. \u041A\u043E\u0433\u0434\u0430
    \u0438\u0445 \u0445\u0432\u0430\u0442\u0438\u0442 \u043D\u0430 \u043E\u0442\u0440\u044F\u0434,
    \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u0435\u0433\u043E \u043A\u0440\u0443\u0436\u043E\u043A
    \u0441\u043B\u0435\u0432\u0430 \u0432\u0432\u0435\u0440\u0445\u0443. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
    \xAB\u0414\u0430\u043B\u0435\u0435\xBB."
  - "\u0417\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u0435 \u0432\u0441\u0435 \u0434\u0435\u0440\u0435\u0432\u043D\u0438
    \u0438\u043B\u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u044C\u0442\u0435 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0439
    \u0448\u0442\u0430\u0431: \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u0435 \u043E\u0442\u0440\u044F\u0434
    \u0438 \u0442\u0430\u043F\u043D\u0438\u0442\u0435 \u043F\u043E \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u043E\u043C\u0443
    \u0437\u0434\u0430\u043D\u0438\u044E. \u0414\u0430\u043B\u044C\u0448\u0435 \u2014
    \u0441\u0430\u043C\u0438. \u0423\u0434\u0430\u0447\u0438!"
  desktopMessages:
  - "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C!
    \u0412\u044B \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0435\u0442\u0435 \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0430\u043C\u0438
    (\u0441\u0438\u043D\u0438\u0435). \u041D\u0430\u0436\u043C\u0438\u0442\u0435
    \xAB\u0414\u0430\u043B\u0435\u0435\xBB."
  - "\u0421\u0434\u0432\u0438\u043D\u044C\u0442\u0435 \u043A\u0430\u0440\u0442\u0443:
    \u043A\u043B\u0430\u0432\u0438\u0448\u0438 WASD \u0438\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u043A\u0438,
    \u043C\u044B\u0448\u044C \u0443 \u043A\u0440\u0430\u044F \u044D\u043A\u0440\u0430\u043D\u0430
    \u0438\u043B\u0438 \u0441\u0440\u0435\u0434\u043D\u044F\u044F \u043A\u043D\u043E\u043F\u043A\u0430.
    \u041A\u043E\u043B\u0435\u0441\u043E \u2014 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u044C
    \u0438\u043B\u0438 \u043E\u0442\u0434\u0430\u043B\u0438\u0442\u044C."
  - "\u0429\u0451\u043B\u043A\u043D\u0438\u0442\u0435 \u043B\u0435\u0432\u043E\u0439
    \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u043F\u043E \u0441\u0432\u043E\u0435\u043C\u0443
    \u043E\u0442\u0440\u044F\u0434\u0443 \u2014 \u043E\u043D \u043E\u0431\u0432\u0435\u0434\u0451\u043D
    \u043A\u0440\u0443\u0433\u043E\u043C."
  - "\u0429\u0451\u043B\u043A\u043D\u0438\u0442\u0435 \u043F\u0440\u0430\u0432\u043E\u0439
    \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u0432 \u043B\u044E\u0431\u0443\u044E
    \u0442\u043E\u0447\u043A\u0443 \u043F\u043E\u043B\u044F \u2014 \u043E\u0442\u0440\u044F\u0434
    \u043F\u043E\u0439\u0434\u0451\u0442 \u0442\u0443\u0434\u0430. \u0417\u0430\u0436\u043C\u0438\u0442\u0435
    \u043F\u0440\u0430\u0432\u0443\u044E \u0438 \u043F\u043E\u0442\u044F\u043D\u0438\u0442\u0435
    \u2014 \u043E\u043D \u0432\u0441\u0442\u0430\u043D\u0435\u0442 \u0444\u0440\u043E\u043D\u0442\u043E\u043C
    \u0432 \u0442\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443."
  - "\u041F\u043E\u0442\u044F\u043D\u0438\u0442\u0435 \u043B\u0435\u0432\u043E\u0439
    \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u0437\u0430 \u043A\u043E\u043B\u044C\u0446\u043E
    \u0432\u043E\u043A\u0440\u0443\u0433 \u043E\u0442\u0440\u044F\u0434\u0430 \u2014
    \u043E\u043D \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F.
    \u041B\u0438\u043D\u0438\u044F \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442
    \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043F\u0435\u0440\u0451\u0434, \u0432
    \u0436\u0451\u043B\u0442\u044B\u0439 \u0441\u0435\u043A\u0442\u043E\u0440."
  - "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041C\u0430\u0440\u0448\xBB
    (R) \u2014 \u043E\u0442\u0440\u044F\u0434 \u0432\u0441\u0442\u0430\u043D\u0435\u0442
    \u0432 \u043A\u043E\u043B\u043E\u043D\u043D\u0443 (\u0431\u044B\u0441\u0442\u0440\u0435\u0435
    \u0438\u0434\u0451\u0442, \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442).
    \xAB\u0412 \u043B\u0438\u043D\u0438\u044E\xBB \u2014 \u043E\u0431\u0440\u0430\u0442\u043D\u043E."
  - "\u041E\u0442\u043F\u0440\u0430\u0432\u044C\u0442\u0435 \u043E\u0442\u0440\u044F\u0434
    \u0432 \u043E\u0431\u0432\u0435\u0434\u0451\u043D\u043D\u0443\u044E \u0434\u0435\u0440\u0435\u0432\u043D\u044E
    \u0438 \u0441\u0442\u043E\u0439\u0442\u0435 \u0442\u0430\u043C, \u043F\u043E\u043A\u0430
    \u0444\u043B\u0430\u0433 \u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0442 \u0441\u0438\u043D\u0438\u043C.
    \u0414\u0435\u0440\u0435\u0432\u043D\u0438 \u0434\u0430\u044E\u0442 \u0437\u043E\u043B\u043E\u0442\u043E."
  - "\u0412\u0440\u0430\u0433 \u0438\u0434\u0451\u0442 \u043D\u0430 \u0432\u0430\u0441
    (\u043E\u0431\u0432\u0435\u0434\u0451\u043D)! \u0420\u0430\u0437\u0432\u0435\u0440\u043D\u0438\u0442\u0435
    \u043A \u043D\u0435\u043C\u0443 \u043B\u0438\u043D\u0438\u044E. \u041A\u043E\u0433\u0434\u0430
    \u043E\u043D \u0432\u043E\u0439\u0434\u0451\u0442 \u0432 \u0436\u0451\u043B\u0442\u044B\u0439
    \u0441\u0435\u043A\u0442\u043E\u0440 \u2014 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \xAB\u0417\u0430\u043B\u043F!\xBB (F)."
  - "\u041E\u0442\u0440\u044F\u0434 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0436\u0430\u0435\u0442\u0441\u044F
    \u2014 \u043A\u043E\u043B\u044C\u0446\u043E \u0437\u0430 \u043D\u0438\u043C \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442\u0441\u044F.
    \u041F\u043E\u043B\u043E\u0441\u043A\u0430 \u043D\u0430\u0434 \u043E\u0442\u0440\u044F\u0434\u043E\u043C
    \u2014 \u0431\u043E\u0435\u0432\u043E\u0439 \u0434\u0443\u0445: \u043F\u0440\u0438
    \u043F\u043E\u0442\u0435\u0440\u044F\u0445 \u043E\u043D \u043F\u0430\u0434\u0430\u0435\u0442,
    \u0438 \u043E\u0442\u0440\u044F\u0434 \u0431\u0435\u0436\u0438\u0442. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
    \xAB\u0414\u0430\u043B\u0435\u0435\xBB."
  - "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0412 \u0448\u0442\u044B\u043A\u0438\xBB
    (C) \u0438 \u0449\u0451\u043B\u043A\u043D\u0438\u0442\u0435 \u043F\u043E \u043E\u0431\u0432\u0435\u0434\u0451\u043D\u043D\u043E\u043C\u0443
    \u0432\u0440\u0430\u0433\u0443. \u0423\u0434\u0430\u0440 \u0432\u043E \u0444\u043B\u0430\u043D\u0433
    \u0438\u043B\u0438 \u0432 \u0442\u044B\u043B \u0441\u0438\u043B\u044C\u043D\u0435\u0435."
  - "\u0429\u0451\u043B\u043A\u043D\u0438\u0442\u0435 \u043F\u043E \u0441\u0432\u043E\u0435\u043C\u0443
    \u0448\u0442\u0430\u0431\u0443 (\u043E\u0431\u0432\u0435\u0434\u0451\u043D),
    \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041A\u0430\u0437\u0430\u0440\u043C\u0430\xBB,
    \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043C\u0435\u0441\u0442\u043E
    \u0440\u044F\u0434\u043E\u043C \u0441\u043E \u0448\u0442\u0430\u0431\u043E\u043C
    \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C\xBB."
  - "\u0429\u0451\u043B\u043A\u043D\u0438\u0442\u0435 \u043F\u043E \u043A\u0430\u0437\u0430\u0440\u043C\u0435
    (\u043E\u0431\u0432\u0435\u0434\u0435\u043D\u0430), \u043A\u043E\u0433\u0434\u0430
    \u043E\u043D\u0430 \u0434\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u0441\u044F,
    \u0438 \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u043D\u0430\u0439\u043C
    \u0444\u0443\u0437\u0438\u043B\u0451\u0440\u043E\u0432."
  - "\u0420\u0435\u043A\u0440\u0443\u0442\u044B \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0442\u0441\u044F
    \u0443 \u043A\u0430\u0437\u0430\u0440\u043C\u044B. \u041A\u043E\u0433\u0434\u0430
    \u0438\u0445 \u0445\u0432\u0430\u0442\u0438\u0442 \u043D\u0430 \u043E\u0442\u0440\u044F\u0434,
    \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u0435\u0433\u043E \u043A\u0440\u0443\u0436\u043E\u043A
    \u0441\u043B\u0435\u0432\u0430 \u0432\u0432\u0435\u0440\u0445\u0443. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
    \xAB\u0414\u0430\u043B\u0435\u0435\xBB."
  - "\u0417\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u0435 \u0432\u0441\u0435 \u0434\u0435\u0440\u0435\u0432\u043D\u0438
    \u0438\u043B\u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u044C\u0442\u0435 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0439
    \u0448\u0442\u0430\u0431: \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u0435 \u043E\u0442\u0440\u044F\u0434
    \u0438 \u0449\u0451\u043B\u043A\u043D\u0438\u0442\u0435 \u043F\u0440\u0430\u0432\u043E\u0439
    \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u043F\u043E \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u043E\u043C\u0443
    \u0437\u0434\u0430\u043D\u0438\u044E. \u0414\u0430\u043B\u044C\u0448\u0435 \u2014
    \u0441\u0430\u043C\u0438. \u0423\u0434\u0430\u0447\u0438!"
  buttonFrameSprite: {fileID: 21300000, guid: e0d94a27149fdca45ae31d4248215472, type: 3}
