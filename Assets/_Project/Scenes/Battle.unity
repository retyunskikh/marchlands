  text: "<b>\u0413\u0440\u0435\u043D\u0430\u0434\u0451\u0440\u044B</b>\n\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C
    \u0438\u043B\u0438 \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043D\u0430\u0439\u043C.
    \u041E\u0442\u0431\u043E\u0440\u043D\u0430\u044F \u043F\u0435\u0445\u043E\u0442\u0430:
    \u043C\u0435\u0442\u0447\u0435 \u0438 \u0441\u0442\u043E\u0439\u0447\u0435, \u043D\u043E
    \u0434\u043E\u0440\u043E\u0436\u0435. \u041F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435
    \u2014 \xABi\xBB."
