  text: "<b>\u0417\u0430\u043B\u043F!</b>   \u041F\u0440\u043E\u0431\u0435\u043B\n\u0412\u044B\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0435
    \u043E\u0442\u0440\u044F\u0434\u044B \u0441\u0442\u0440\u0435\u043B\u044F\u044E\u0442
    \u043F\u043E \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C\u0443 \u0432\u0440\u0430\u0433\u0443
    \u0432 \u0436\u0451\u043B\u0442\u043E\u043C \u0441\u0435\u043A\u0442\u043E\u0440\u0435.
    \u041F\u043E\u0442\u043E\u043C \u2014 \u0434\u043E\u043B\u0433\u0430\u044F \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430."
