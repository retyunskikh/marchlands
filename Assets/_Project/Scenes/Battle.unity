  text: "<b>\u041A\u043E\u043D\u0438</b>\n\u0421\u043A\u043E\u043B\u044C\u043A\u043E
    \u043A\u043E\u043D\u0435\u0439 \u0437\u0430\u043D\u044F\u0442\u043E \u0438 \u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0432\u043C\u0435\u0449\u0430\u044E\u0442 \u043A\u043E\u043D\u044E\u0448\u043D\u0438.
    \u041A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C \u2014 \u0440\u0430\u0441\u0448\u0438\u0440\u044C\u0442\u0435
