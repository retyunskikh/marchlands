  m_Script: {fileID: 11500000, guid: add159466789c984593ee7acfa57c43f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Game.UI::Marchlands.UI.UnitInfoPanel
  panel: {fileID: 1949478837}
  titleLabel: {fileID: 496331789}
  bodyLabel: {fileID: 734248861}
  closeButton: {fileID: 1609435549}
  portrait: {fileID: 613399376}
  francePortraits:
  - {fileID: 21300000, guid: bc46f8b0b32bd0a4c922510a174ca3bf, type: 3}
  - {fileID: 21300000, guid: aad90d5e78f15c74cb194d9ff4a3b94d, type: 3}
  - {fileID: 21300000, guid: 0de4c7d01ca76c444840fc06a8375673, type: 3}
  austriaPortraits:
  - {fileID: 21300000, guid: ab2f18521932d864d9bfdab4552465b6, type: 3}
  - {fileID: 21300000, guid: 70f806e428a34f54d927fbb337a98533, type: 3}
  - {fileID: 21300000, guid: e52bac5a38a67d641815559cc7121cb9, type: 3}
  grenadiersTitle: "\u0413\u0440\u0435\u043D\u0430\u0434\u0451\u0440\u044B"
  fusiliersTitle: "\u0424\u0443\u0437\u0438\u043B\u0451\u0440\u044B"
  cavalryTitle: "\u041A\u043E\u043D\u043D\u0438\u0446\u0430"
  grenadiersNote: "\u041E\u0442\u0431\u043E\u0440\u043D\u0430\u044F \u043F\u0435\u0445\u043E\u0442\u0430:
    \u043C\u0435\u0442\u0447\u0435 \u0441\u0442\u0440\u0435\u043B\u044F\u044E\u0442,
    \u043A\u0440\u0435\u043F\u043A\u0430\u044F \u043C\u043E\u0440\u0430\u043B\u044C,
    \u0441\u0438\u043B\u044C\u043D\u044B \u0432 \u0448\u0442\u044B\u043A\u043E\u0432\u043E\u0439.
    \u0414\u043E\u0440\u043E\u0436\u0435 \u0444\u0443\u0437\u0438\u043B\u0451\u0440\u043E\u0432
    \u0438 \u043D\u0430\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F \u0432\u0434\u0432\u043E\u0435
    \u0434\u043E\u043B\u044C\u0448\u0435."
  fusiliersNote: "\u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u043B\u0438\u043D\u0435\u0439\u043D\u0430\u044F
    \u043F\u0435\u0445\u043E\u0442\u0430: \u0434\u0451\u0448\u0435\u0432\u044B \u0438
    \u0431\u044B\u0441\u0442\u0440\u043E \u043D\u0430\u0431\u0438\u0440\u0430\u044E\u0442\u0441\u044F,
    \u043D\u043E \u0443\u0441\u0442\u0443\u043F\u0430\u044E\u0442 \u0433\u0440\u0435\u043D\u0430\u0434\u0451\u0440\u0430\u043C
    \u0432 \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u0438 \u0438 \u0448\u0442\u044B\u043A\u043E\u0432\u043E\u0439."
  cavalryNote: "\u0414\u043E\u0440\u043E\u0433\u0430\u044F \u0438 \u0431\u044B\u0441\u0442\u0440\u0430\u044F,
    \u0441\u0442\u0440\u0430\u0448\u043D\u0430 \u0432 \u0430\u0442\u0430\u043A\u0435
    \u0432 \u0441\u0430\u0431\u043B\u0438. \u0421\u0442\u0440\u0435\u043B\u044F\u0442\u044C
    \u043D\u0435 \u043C\u043E\u0436\u0435\u0442."
